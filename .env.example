# ============================================
# Mine Manager - Variaveis de Ambiente
# ============================================
# 
# Copie este arquivo para .env e configure os valores:
#   cp .env.example .env
#   nano .env
#
# Ou configure diretamente no docker-compose.yml
#
# ============================================

# ============================================
# VARIAVEIS OBRIGATORIAS
# ============================================

# Token de autenticacao da API do Pterodactyl
# Obtenha em: Painel > Account Settings > API Credentials
# Formato: ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IMPORTANTE: Substitua pelo seu token real!
USER_TOKEN=ptlc_seu_token_aqui

# Dominio do painel Pterodactyl
# Formato: https://painel.seudominio.com.br
# IMPORTANTE: Use HTTPS e nao inclua barra no final!
DOMAIN=https://painel.seudominio.com.br

# ============================================
# VARIAVEIS OPCIONAIS
# ============================================

# Porta da API HTTP do manager (comunicacao interna entre containers)
# Default: 8080
# Esta porta e usada apenas para comunicacao interna entre containers Docker
# Nao precisa ser exposta externamente
MANAGER_API_PORT=8080

# Nome do container do manager (usado pelos fake servers para se conectar)
# Default: mine-manager
# Geralmente nao precisa ser alterado, a menos que voce mude o nome do container
MANAGER_CONTAINER_NAME=mine-manager

# Tempo de inatividade antes de parar o servidor (em minutos)
# Default: 60 minutos
# Apos este tempo sem jogadores, o servidor sera parado automaticamente
INACTIVITY_TIMEOUT_MINUTES=60

# Timezone (ajuste conforme sua localizacao)
# Default: America/Sao_Paulo
# Lista de timezones: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Exemplos:
#   - America/Sao_Paulo (Brasil)
#   - America/New_York (EUA - Leste)
#   - Europe/London (Reino Unido)
#   - Asia/Tokyo (Japao)
TZ=America/Sao_Paulo

# ============================================
# NOTAS
# ============================================
#
# 1. Portas dos servidores Minecraft:
#    - As portas sao obtidas automaticamente do Pterodactyl
#    - Nao e necessario configurar portas manualmente
#    - O sistema detecta automaticamente a porta de cada servidor
#
# 2. Rede Docker:
#    - O sistema usa a rede 'mine-network' para comunicacao entre containers
#    - A rede e criada automaticamente pelo docker-compose.yml
#    - Os fake servers sao criados automaticamente na mesma rede do manager
#
# 3. Fake Servers:
#    - Os fake servers sao criados automaticamente quando um servidor esta offline
#    - Eles detectam tentativas de login e iniciam o servidor real automaticamente
#    - Nao e necessario configurar nada manualmente
#
# ============================================