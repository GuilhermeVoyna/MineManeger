# Dockerfile para o fake server standalone
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copiar arquivos de dependências
COPY go.mod go.sum ./
RUN go mod download

# Copiar código fonte
COPY internal/fakeserver ./internal/fakeserver
COPY cmd/fakeserver ./cmd/fakeserver

# Compilar para Linux
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o fakeserver ./cmd/fakeserver

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

# Copiar binário compilado
COPY --from=builder /app/fakeserver .

# Expor porta (será mapeada dinamicamente)
EXPOSE 25565

# Usar ENTRYPOINT para permitir passar argumentos
ENTRYPOINT ["./fakeserver"]

